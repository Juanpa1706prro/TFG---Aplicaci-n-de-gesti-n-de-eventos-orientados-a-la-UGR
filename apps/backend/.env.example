# ---------------------------------------------------------------------------
# JWT (autenticación — solo en servidor, nunca en el frontend)
# Genera secretos aleatorios, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Google Routes API (Paso 0 — clave solo en servidor, nunca en el frontend)
# Copia este archivo a .env y rellena GOOGLE_ROUTES_API_KEY tras crear la clave
# en Google Cloud Console. Ver docs/google-routes-setup.md
# ---------------------------------------------------------------------------
GOOGLE_ROUTES_API_KEY=

# ---------------------------------------------------------------------------
# Gemini (asistente IA — clave solo en servidor, nunca en el frontend)
# Clave en https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
